    "\n",
    "print(f\"Algorithm   : {ALGORITHM}\")\n",
    "print(f\"Baseline    : {BASELINE}  ({'adaptive geometric' if BASELINE == -1 else 'G_t whitening' if BASELINE == 0 else f'fixed geometric ({BASELINE})'})\")\n",
    "print(f\"Normalize   : {NORMALIZE}\")\n",
    "print(f\"Device      : {DEVICE}\")\n",
