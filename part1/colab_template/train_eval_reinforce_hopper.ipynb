    "ALGORITHM = 'reinforce'  # 'reinforce' | 'actor_critic'\n",
    "\n",
    "# BASELINE options for REINFORCE (ignored by actor_critic):\n",
    "#   -1  → adaptive geometric: b_t = mean(last-100 G_0) * (1 - γ^(T-t)) / (1 - γ^T)\n",
    "#          advantage G_t - b_t divided by std when NORMALIZE=True\n",
    "#    0  → pure REINFORCE; G_t whitened (mean=0, std=1) when NORMALIZE=True\n",
    "#   >0  → fixed geometric: b_t = BASELINE * (1 - γ^(T-t)) / (1 - γ^T)\n",
    "BASELINE  = -1\n",
    "\n",
    "# NORMALIZE: see markdown above for per-mode behaviour\n",
    "NORMALIZE = False\n",
    "\n",
    "# DEVICE: 'cpu' avoids CPU<->GPU transfer overhead for this small batch-size-1 workload.\n",
    "# Switch to 'cuda' or 'xpu' only for significantly larger networks.\n",
    "DEVICE    = 'cpu'\n",
    "\n",
    "NUM_EPISODES = 20000\n",
    "SEED         = 42\n",
    "\n",
    "# Checkpoint folder: same convention as train.py CLI so both end up in the same place\n",
    "CHECKPOINT_DIR = os.path.join(REPO_ROOT, \"part1\", \"checkpoints\", f\"{ALGORITHM}_baseline_{BASELINE}\")\n",
